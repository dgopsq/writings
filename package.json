{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "docs:check": "bash scripts/check-docs.sh",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prebuild.mts",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@netgrep/netgrep": "^0.1.5",
    "feed": "^6.0.0",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "simple-icons": "^16.27.1",
    "strip-markdown": "^6.0.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "gray-matter": "^4.0.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
