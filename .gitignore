# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.vscode
.env

# typescript incremental build cache
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# build-time generated artifacts (see scripts/prebuild.ts)
public/rss
public/posts-meta

# agent scratch state (per-session, never commit)
.claude/state/
.claude/settings.local.json